include README.md
include LICENSE
include MANIFEST.in
include pyproject.toml
include requirements.txt
include .env.example

recursive-include configs *.yaml
recursive-include docs *.md
# Internal material must not ship in the public sdist: work journals
# (Spanish, internal) and archived pre-Phase-0 marketing narrative.
prune docs/_workjournal
prune docs/_archive
recursive-include packaging *
recursive-include scripts *.py
recursive-include ops/env *.env
recursive-include .github/workflows *.yml
recursive-include .github/actions *.yml

global-exclude __pycache__ *.py[cod] .DS_Store
prune .pytest_cache
prune tests/__pycache__
